# E2E 测试环境配置
# 用于 Playwright 测试的环境变量

# 测试目标环境（生产环境）
NEXT_PUBLIC_APP_URL=https://jarvis-neo.zeabur.app

# Playwright 测试配置
BASE_URL=https://jarvis-neo.zeabur.app

# API 配置（如果需要测试需要认证的 API）
# QWEN_API_KEY=your_test_qwen_api_key
# GLM_API_KEY=your_test_glm_api_key

# 测试超时设置（毫秒）
TEST_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# 截图和视频配置
SCREENSHOT_ON_FAILURE_ONLY=true
VIDEO_RETENTION_ON_FAILURE=true

# 并行执行配置
WORKERS=1
